  name: "v1_search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "api_key"
                orig: "api_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "Homework"
                kind: "query"
                name: "a"
                orig: "a"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "daft_punk"
                kind: "query"
                name: "s"
                orig: "s"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{apiKey}/searchalbum.php"
          parts: [
            "{api_key}"
            "searchalbum.php"
          ]
          rename: {
            param: {
              apiKey: "api_key"
            }
          }
          select: {
            exist: [
              "a"
              "api_key"
              "s"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.album`"
          }
        }
        {
