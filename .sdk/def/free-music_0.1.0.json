{
  "openapi": "3.0.3",
  "info": {
    "title": "Free Music API",
    "description": "TheAudioDB provides a free music API to use in test or development environments. Access real-time music data including Artists, Albums, Songs, and Music Venues.",
    "version": "1.0.0",
    "contact": {
      "name": "TheAudioDB",
      "url": "https://www.theaudiodb.com"
    },
    "termsOfService": "https://www.theaudiodb.com"
  },
  "servers": [
    {
      "url": "https://www.theaudiodb.com/api/v1/json",
      "description": "V1 API Server"
    },
    {
      "url": "https://www.theaudiodb.com/api/v2/json",
      "description": "V2 API Server (Premium only)"
    }
  ],
  "paths": {
    "/{apiKey}/search.php": {
      "get": {
        "summary": "Search Artist",
        "description": "Search for any music artist by name. Returns up to 1 result for free tier, 10 for premium.",
        "tags": [
          "V1 Search"
        ],
        "parameters": [
          {
            "name": "apiKey",
            "in": "path",
            "required": true,
            "description": "API key (use '123' for free tier)",
            "schema": {
              "type": "string",
              "default": "123"
            }
          },
          {
            "name": "s",
            "in": "query",
            "required": true,
            "description": "Artist name to search",
            "schema": {
              "type": "string"
            },
            "example": "coldplay"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "artists": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Artist"
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/{apiKey}/discography.php": {
      "get": {
        "summary": "Get Artist Discography",
        "description": "Get discography for an artist by name",
        "tags": [
          "V1 Search"
        ],
        "parameters": [
          {
            "name": "apiKey",
