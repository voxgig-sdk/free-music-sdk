          {
            "name": "s",
            "in": "query",
            "required": true,
            "description": "Artist name",
            "schema": {
              "type": "string"
            },
            "example": "daft_punk"
          },
          {
            "name": "a",
            "in": "query",
            "required": false,
            "description": "Album name",
            "schema": {
              "type": "string"
            },
            "example": "Homework"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "album": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Album"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
