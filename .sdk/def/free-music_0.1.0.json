    "/{apiKey}/searchalbum.php": {
      "get": {
        "summary": "Search Album",
        "description": "Search for albums by artist name and optionally album name",
        "tags": [
          "V1 Search"
        ],
        "parameters": [
          {
            "name": "apiKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
